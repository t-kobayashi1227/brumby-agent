    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fflate": "^0.8.3",
    "mapshaper": "^0.7.98",
